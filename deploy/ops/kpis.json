{
  "version": 1,
  "note": "One definition of the core's service KPIs. tools/g5c-kpi computes them from /metrics (a lab run, a diagnostics bundle or a live function) and generates the Prometheus recording rules (prometheus-kpi-rules.yml) from the same text, so the lab and the production numbers are the same arithmetic. 'ref' names the closest TS 28.552 / 28.554 measurement family and is for orientation (verify the exact clause before quoting it in a report). A KPI with `by` gets one row per value of that label (the PDU session counter carries the slice).",
  "kpis": [
    {"id": "registration_attempts", "name": "Registration requests", "kind": "sum", "unit": "count", "ref": "TS 28.552 RM.RegInitReq family",
     "of": [{"metric": "g5c_amf_registrations_total"}]},
    {"id": "registration_success_rate", "name": "Registration success rate", "kind": "ratio", "unit": "percent", "ref": "TS 28.552 RM.RegInitSucc / RM.RegInitReq",
     "num": [{"metric": "g5c_amf_registrations_total", "labels": {"result": "accepted"}}], "den": [{"metric": "g5c_amf_registrations_total"}],
     "target": {"op": ">=", "value": 99.0, "min_den": 20}},
    {"id": "authentication_success_rate", "name": "5G-AKA success rate", "kind": "ratio", "unit": "percent", "ref": "TS 33.501 authentication; operator KPI",
     "num": [{"metric": "g5c_amf_authentications_total", "labels": {"result": "success"}}], "den": [{"metric": "g5c_amf_authentications_total"}],
     "target": {"op": ">=", "value": 99.0, "min_den": 20}},
    {"id": "service_request_success_rate", "name": "Service request success rate", "kind": "ratio", "unit": "percent", "ref": "TS 28.552 RM service request family",
     "num": [{"metric": "g5c_amf_service_requests_total", "labels": {"result": "accepted"}}], "den": [{"metric": "g5c_amf_service_requests_total"}],
     "target": {"op": ">=", "value": 99.0, "min_den": 20}},
    {"id": "pdu_session_establishment_success_rate", "name": "PDU session establishment success rate", "kind": "ratio", "unit": "percent", "ref": "TS 28.552 SM.PduSessionEstab* family",
     "num": [{"metric": "g5c_amf_pdu_session_requests_total", "labels": {"result": "created"}}], "den": [{"metric": "g5c_amf_pdu_session_requests_total"}],
     "target": {"op": ">=", "value": 99.0, "min_den": 20}},
    {"id": "pdu_session_success_per_slice", "name": "PDU session establishment success rate", "kind": "ratio", "unit": "percent", "by": "snssai", "ref": "TS 28.552 SM.PduSessionEstab* family, per S-NSSAI",
     "num": [{"metric": "g5c_amf_pdu_session_requests_total", "labels": {"result": "created"}}], "den": [{"metric": "g5c_amf_pdu_session_requests_total"}],
     "target": {"op": ">=", "value": 99.0, "min_den": 20}},
    {"id": "handover_success_rate", "name": "N2 handover success rate", "kind": "ratio", "unit": "percent", "ref": "TS 28.552 MM handover family",
     "num": [{"metric": "g5c_amf_handover_total", "labels": {"result": "completed"}}], "den": [{"metric": "g5c_amf_handover_total"}],
     "target": {"op": ">=", "value": 95.0, "min_den": 20}},
    {"id": "nas_procedure_timeouts", "name": "NAS procedures aborted by a timer", "kind": "sum", "unit": "count", "ref": "operator KPI",
     "of": [{"metric": "g5c_amf_procedure_timeouts_total"}]},
    {"id": "registered_ues", "name": "Registered UEs", "kind": "gauge", "unit": "count", "ref": "TS 28.552 RM.RegisteredSubNbrMean family",
     "of": [{"metric": "g5c_amf_registered_ues"}]},
    {"id": "connected_ues", "name": "UEs in CM-CONNECTED", "kind": "gauge", "unit": "count", "ref": "operator KPI",
     "of": [{"metric": "g5c_amf_connected_ues"}]},
    {"id": "active_pdu_sessions", "name": "Active PDU sessions", "kind": "gauge", "unit": "count", "ref": "TS 28.552 SM active sessions family",
     "of": [{"metric": "g5c_smf_pdu_sessions_active"}]},
    {"id": "connected_gnbs", "name": "Connected gNBs", "kind": "gauge", "unit": "count", "ref": "operator KPI",
     "of": [{"metric": "g5c_amf_gnbs"}]},
    {"id": "sm_context_create_p95", "name": "Create SM Context latency, 95th percentile", "kind": "quantile", "unit": "seconds", "ref": "operator KPI",
     "histogram": "g5c_smf_create_sm_context_seconds", "q": 0.95, "target": {"op": "<=", "value": 0.5, "min_den": 20}},
    {"id": "sbi_error_rate", "name": "SBI responses with a 5xx status", "kind": "ratio", "unit": "percent", "ref": "operator KPI",
     "num": [{"metric": "g5c_sbi_requests_total", "labels_re": {"status": "5.."}}], "den": [{"metric": "g5c_sbi_requests_total"}],
     "target": {"op": "<=", "value": 1.0, "min_den": 100}},
    {"id": "uplink_throughput", "name": "User-plane uplink throughput", "kind": "rate", "unit": "bit/s", "scale": 8, "ref": "TS 28.552 GTP data volume / throughput family",
     "of": [{"metric": "g5c_upf_bytes_total", "labels": {"direction": "uplink"}}]},
    {"id": "downlink_throughput", "name": "User-plane downlink throughput", "kind": "rate", "unit": "bit/s", "scale": 8, "ref": "TS 28.552 GTP data volume / throughput family",
     "of": [{"metric": "g5c_upf_bytes_total", "labels": {"direction": "downlink"}}]},
    {"id": "user_plane_drop_rate", "name": "User-plane packets dropped", "kind": "ratio", "unit": "percent", "ref": "operator KPI",
     "num": [{"metric": "g5c_upf_dropped_packets_total"}], "den": [{"metric": "g5c_upf_packets_total"}],
     "den_add": [{"metric": "g5c_upf_dropped_packets_total"}], "target": {"op": "<=", "value": 1.0, "min_den": 1000}},
    {"id": "charging_records", "name": "Charging records written", "kind": "sum", "unit": "count", "ref": "TS 32.255 / 32.298 charging data",
     "of": [{"metric": "g5c_smf_cdrs_written_total"}]}
  ]
}
