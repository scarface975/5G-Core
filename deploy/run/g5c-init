#!/usr/bin/env python3
"""g5c-init: a working configuration for one host from a few answers (backlog F-07).

  g5c-init --dir /etc/g5c --mcc 262 --mnc 01 --tac 1,2 --n2-address 192.0.2.10 [--n3-address 192.0.2.10] [--ue-pool 10.45.0.0/16] [--no-tls] [--yes]

Asks for what is missing when it runs in a terminal (--yes takes the defaults and never asks). It writes, under --dir:
  conf/<function>.yaml   the twelve configurations (the ones deploy/run/g5c-cluster.sh uses, with your PLMN, tracking areas, addresses and UE pool)
  keys/                  fresh secrets: the admin token, the UDM and AUSF master keys, the UDR provisioning token and a new SUCI home network key (mode 0600)
  pki/                   with TLS (the default): a CA and one certificate per function and for the operator, the function addresses as subject alternative names
  START-HERE.md          the commands to start the functions, provision a first subscriber and check the result
Nothing is started and nothing outside --dir is changed. The functions talk to each other on loopback addresses (127.2.0.x); only the N2 (AMF) and N3 (UPF) addresses face the radio
network. Existing files are kept: run it again with the same --dir to add what is missing, remove a file to have it made anew."""
import argparse
import os
import re
import secrets
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
CLUSTER = HERE / "g5c-cluster.sh"


def ask(prompt, default, interactive, check=None):
    if not interactive:
        return default
    while True:
        v = input("%s [%s]: " % (prompt, default)).strip() or default
        if check is None or check(v):
            return v
        print("  not valid, try again")


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--dir", default="g5c-config")
    ap.add_argument("--mcc")
    ap.add_argument("--mnc")
    ap.add_argument("--tac", help="tracking area codes the AMF serves, comma separated")
    ap.add_argument("--n2-address", help="the address the gNB connects to (AMF, SCTP 38412)")
    ap.add_argument("--n3-address", help="the address the gNB sends user plane traffic to (UPF, UDP 2152); default: the N2 address")
    ap.add_argument("--ue-pool", help="IPv4 pool for the UEs, CIDR")
    ap.add_argument("--n6-dev", default=None, help="TUN device for the data network (default ogstun)")
    ap.add_argument("--no-tls", action="store_true", help="plain HTTP/2 between the functions (a lab only)")
    ap.add_argument("--systemd", action="store_true", help="also write systemd units for these configurations under <dir>/systemd (see START-HERE.md)")
    ap.add_argument("--bin-dir", default="/usr/local/bin", help="where the function binaries are installed (for --systemd)")
    ap.add_argument("--pin-peers", action="store_true", help="each function accepts client certificates only from the functions that call it (needs TLS)")
    ap.add_argument("--yes", action="store_true", help="take defaults, never ask")
    a = ap.parse_args()
    interactive = sys.stdin.isatty() and not a.yes
    mcc = a.mcc or ask("Mobile country code (3 digits)", "001", interactive, lambda v: re.fullmatch(r"\d{3}", v))
    mnc = a.mnc or ask("Mobile network code (2 or 3 digits)", "01", interactive, lambda v: re.fullmatch(r"\d{2,3}", v))
    tac = a.tac or ask("Tracking area codes, comma separated", "1,2", interactive, lambda v: re.fullmatch(r"\d+(\s*,\s*\d+)*", v))
    n2 = a.n2_address or ask("N2 address of the AMF (what the gNB connects to)", "127.2.0.5", interactive, lambda v: re.fullmatch(r"[0-9.]+|[0-9a-fA-F:]+", v))
    n3 = a.n3_address or ask("N3 address of the UPF", n2 if n2 != "127.2.0.5" else "127.2.0.7", interactive, lambda v: re.fullmatch(r"[0-9.]+|[0-9a-fA-F:]+", v))
    pool = a.ue_pool or ask("UE address pool", "10.45.0.0/16", interactive, lambda v: re.fullmatch(r"\d+\.\d+\.\d+\.\d+/\d+", v))
    for name, v in (("mcc", mcc), ("mnc", mnc)):
        if not re.fullmatch(r"\d{3}" if name == "mcc" else r"\d{2,3}", v):
            sys.exit("g5c-init: --%s is not valid" % name)
    run = Path(a.dir).resolve()
    keys = run / "keys"
    keys.mkdir(parents=True, exist_ok=True)
    # fresh secrets before the generator runs: it only creates what is missing, and its fallbacks are the public test values
    for name, nbytes in (("admin_token", 24), ("master.key", 32), ("ausf-master.key", 32), ("udr-provisioning.token", 24), ("hn-1.key", 32)):
        f = keys / name
        if not f.exists():
            f.write_text(secrets.token_hex(nbytes))
        f.chmod(0o600)
    env = dict(os.environ, G5C_RUN=str(run), G5C_MCC=mcc, G5C_MNC=mnc, G5C_TAC=tac, G5C_AMF_ADDR=n2, G5C_UPF_ADDR=n3, G5C_UE_POOL=pool, G5C_TLS="0" if a.no_tls else "1", G5C_PIN_PEERS="1" if a.pin_peers and not a.no_tls else "0")
    if a.n6_dev:
        env["G5C_N6_DEV"] = a.n6_dev
    p = subprocess.run(["bash", str(CLUSTER), "conf"], env=env, capture_output=True, text=True)
    if p.returncode != 0:
        sys.exit("g5c-init: configuration generator failed:\n" + p.stderr[-600:])
    nconf = len(list((run / "conf").glob("*.yaml")))
    if a.systemd:  # the shipped unit, pointed at this directory: configurations, state and keys stay where g5c-init put them
        unit_dir = run / "systemd"
        (unit_dir / "g5c@upf.service.d").mkdir(parents=True, exist_ok=True)
        text = (HERE.parent / "systemd" / "g5c@.service").read_text(encoding="utf-8")
        text = "# Generated by g5c-init for %s: the shipped unit (deploy/systemd/g5c@.service), pointed at this directory.\n" % run + text[text.index("[Unit]"):]
        text = text.replace("ExecStart=/usr/local/bin/%i /etc/g5c/%i.yaml", "ExecStart=%s/%%i %s/conf/%%i.yaml" % (a.bin_dir, run))
        text = text.replace("ReadWritePaths=/var/lib/g5c", "ReadWritePaths=%s/state %s/log" % (run, run))
        text = text.replace("StateDirectory=g5c\nConfigurationDirectory=g5c\nLogsDirectory=g5c\n", "")
        text = text.replace("Documentation=file:///usr/share/doc/g5c/install.md", "Documentation=file://%s/START-HERE.md" % run)
        (unit_dir / "g5c@.service").write_text(text, encoding="utf-8", newline="\n")
        for extra in ("g5c.target", "g5c@upf.service.d/override.conf"):
            (unit_dir / extra).write_text((HERE.parent / "systemd" / extra).read_text(encoding="utf-8"), encoding="utf-8", newline="\n")
        (run / "state").mkdir(exist_ok=True)
    guide = f"""# Your g5c configuration

Generated by `g5c-init`. PLMN {mcc}/{mnc}, tracking areas {tac}, N2 {n2}:38412, N3 {n3}:2152, UE pool {pool}, {"mutual TLS between the functions" if not a.no_tls else "NO TLS between the functions (lab only)"}.

## Start the functions (in this order; each in its own terminal or as a service)
```
for nf in nrf scp bsf udr nssf nef udm ausf pcf upf smf amf; do bin/$nf {run}/conf/$nf.yaml & done
```
(`bin/` is where `deploy/install.sh` put the binaries; `deploy/systemd` has units that do the same under systemd.) The UPF needs the TUN device `{a.n6_dev or "ogstun"}` and IP forwarding:
`ip tuntap add name {a.n6_dev or "ogstun"} mode tun; ip addr add {pool.rsplit('.', 2)[0]}.0.1/16 dev {a.n6_dev or "ogstun"}; ip link set {a.n6_dev or "ogstun"} up; sysctl -w net.ipv4.ip_forward=1`.

{{systemd_section}}
## Provision a first subscriber
```
{"G5C_TLS_CA=" + str(run) + "/pki/ca.crt G5C_TLS_CERT=" + str(run) + "/pki/admin.crt G5C_TLS_KEY=" + str(run) + "/pki/admin.key " if not a.no_tls else ""}g5c-ctl --udm {"https" if not a.no_tls else "http"}://127.2.0.1:7773 --token-file {run}/keys/admin_token \\
  subscriber add --supi imsi-{mcc}{mnc}0000000001 --k <32 hex> --opc <32 hex> --slice 1 --dnn internet
```
Bulk: `tools/cli/g5c-subscribers import --format open5gs dump.json --apply ...`.

## Check
`tools/cli/g5c-kpi {"https" if not a.no_tls else "http"}://127.2.0.5:7777/metrics` (set `G5C_CURL_ARGS="--cacert {run}/pki/ca.crt --cert {run}/pki/admin.crt --key {run}/pki/admin.key"` with TLS) and `tools/cli/g5c-diag` for a support bundle.

## Secrets
`{run}/keys/` holds the admin token, the master keys and the home network key, all new and random. Back them up: losing `master.key` loses every stored subscriber credential.
The home network key is the SUCI key of this network: give its public part to your SIM provisioning, keep the private key secret.
"""
    sysd = ("""## As services (written by --systemd)
```
sudo useradd --system --no-create-home g5c   # once; then: sudo chown -R g5c:g5c %s/state %s/log %s/keys %s/pki
sudo cp %s/systemd/g5c@.service %s/systemd/g5c.target /etc/systemd/system/ && sudo cp -r %s/systemd/g5c@upf.service.d /etc/systemd/system/
sudo systemctl daemon-reload && sudo systemctl enable --now g5c.target
```
The units run `%s/<function>` with `%s/conf/<function>.yaml`. The UPF unit adds the capability it needs for the TUN device.
""" % (run, run, run, run, run, run, run, a.bin_dir, run)) if a.systemd else ""
    guide = guide.replace("{systemd_section}", sysd)
    (run / "START-HERE.md").write_text(guide, encoding="utf-8")
    print("g5c-init: %d configurations, secrets%s in %s" % (nconf, "" if a.no_tls else ", a CA and certificates", run))
    print("next: read %s" % (run / "START-HERE.md"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
