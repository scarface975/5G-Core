{
  "note": "Procedure rules of g5c-conform: what must be seen in the signalling of one UE (NGAP / NAS), one N4 session or the N2 interface, and in what order. A rule checks the messages that are visible in a capture: after the Security Mode Command the NAS messages are ciphered, so only the NGAP transport shows. `then` lists the milestones that must follow the trigger in this order (a milestone is a phrase of the ladder line); `unless` phrases end the check (a reject, a failure). `answers` lists requests with the phrases that count as an answer and the time allowed in seconds.",
  "rules": [
    {"id": "REG-FLOW", "scope": "ue", "severity": "high", "clause": "TS 24.501 5.5.1.2, TS 33.501 6.1.2", "title": "a registration that is accepted goes through authentication and security mode before the context is set up",
     "trigger": "Registration request", "then": ["Authentication request", "Authentication response", "Security mode command", "InitialContextSetupRequest"], "unless": ["Registration reject", "Authentication reject", "Authentication failure (Non-5G authentication unacceptable)"], "needs": "InitialContextSetupRequest"},
    {"id": "REG-CTX", "scope": "ue", "severity": "medium", "clause": "TS 24.501 5.5.1.2.2", "title": "a registration request ends in a context setup or a reject",
     "trigger": "Registration request", "then": ["InitialContextSetupRequest"], "unless": ["Registration reject", "Authentication reject", "UEContextReleaseCommand", "ErrorIndication"]},
    {"id": "N2-ANSWERS", "scope": "ue", "severity": "high", "clause": "TS 38.413 8.3.1, 8.2.1, 8.3.3", "title": "NGAP requests are answered",
     "answers": [{"request": "InitialContextSetupRequest", "response": ["InitialContextSetupResponse", "InitialContextSetupFailure"], "within_s": 10},
                 {"request": "PDUSessionResourceSetupRequest", "response": ["PDUSessionResourceSetupResponse", "PDUSessionResourceSetupFailure"], "within_s": 10},
                 {"request": "UEContextReleaseCommand", "response": ["UEContextReleaseComplete"], "within_s": 10},
                 {"request": "PDUSessionResourceReleaseCommand", "response": ["PDUSessionResourceReleaseResponse"], "within_s": 10}]},
    {"id": "AUTH-TIMER", "scope": "ue", "severity": "medium", "clause": "TS 24.501 10.2.2 (T3560)", "title": "an Authentication request is answered within T3560 (6 s)",
     "answers": [{"request": "Authentication request", "response": ["Authentication response", "Authentication failure"], "within_s": 6}]},
    {"id": "N2-SETUP", "scope": "n2", "severity": "high", "clause": "TS 38.413 8.7.1", "title": "an NG Setup Request is answered",
     "answers": [{"request": "NGSetupRequest", "response": ["NGSetupResponse", "NGSetupFailure"], "within_s": 5}]},
    {"id": "N4-ESTABLISH", "scope": "n4", "severity": "high", "clause": "TS 29.244 7.5.2", "title": "a PFCP Session Establishment Request is answered",
     "answers": [{"request": "PFCP Session Establishment Request", "response": ["PFCP Session Establishment Response"], "within_s": 5}]},
    {"id": "N4-DELETE", "scope": "n4", "severity": "medium", "clause": "TS 29.244 7.5.6", "title": "a PFCP Session Deletion Request is answered",
     "answers": [{"request": "PFCP Session Deletion Request", "response": ["PFCP Session Deletion Response"], "within_s": 5}]},
    {"id": "N2-MOBILITY", "scope": "ue", "severity": "high", "clause": "TS 38.413 8.4.1, 8.4.2, 8.4.4", "title": "handover and path switch requests are answered",
     "answers": [{"request": "HandoverRequired", "response": ["HandoverCommand", "HandoverPreparationFailure"], "within_s": 10},
                 {"request": "HandoverRequest", "response": ["HandoverRequestAcknowledge", "HandoverFailure"], "within_s": 10},
                 {"request": "PathSwitchRequest", "response": ["PathSwitchRequestAcknowledge", "PathSwitchRequestFailure"], "within_s": 10}]},
    {"id": "N2-MODIFY", "scope": "ue", "severity": "medium", "clause": "TS 38.413 8.2.3", "title": "a PDU session resource modification is answered",
     "answers": [{"request": "PDUSessionResourceModifyRequest", "response": ["PDUSessionResourceModifyResponse"], "within_s": 10}]},
    {"id": "N2-RELEASE-REQ", "scope": "ue", "severity": "medium", "clause": "TS 38.413 8.3.2", "title": "a UE Context Release Request from the gNB is followed by a UE Context Release Command",
     "answers": [{"request": "UEContextReleaseRequest", "response": ["UEContextReleaseCommand"], "within_s": 10}]},
    {"id": "SERVICE-FLOW", "scope": "ue", "severity": "medium", "clause": "TS 24.501 5.6.1.4", "title": "a Service request that is accepted re-establishes the context before the user plane resumes",
     "trigger": "Service request", "then": ["InitialContextSetupRequest"], "unless": ["Service reject", "Registration reject", "UEContextReleaseCommand", "ErrorIndication"], "needs": "InitialContextSetupRequest"},
    {"id": "N2-RESET", "scope": "n2", "severity": "medium", "clause": "TS 38.413 8.7.4, 8.7.2", "title": "an NG Reset and a RAN Configuration Update are answered",
     "answers": [{"request": "NGReset", "response": ["NGResetAcknowledge"], "within_s": 10},
                 {"request": "RANConfigurationUpdate", "response": ["RANConfigurationUpdateAcknowledge", "RANConfigurationUpdateFailure"], "within_s": 10}]},
    {"id": "N4-MODIFY", "scope": "n4", "severity": "medium", "clause": "TS 29.244 7.5.4", "title": "a PFCP Session Modification Request is answered",
     "answers": [{"request": "PFCP Session Modification Request", "response": ["PFCP Session Modification Response"], "within_s": 5}]}
  ]
}
