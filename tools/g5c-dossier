#!/usr/bin/env python3
"""g5c-dossier: the conformance report and the release dossier (backlog B-06 and I-05).

  g5c-dossier report  [--results build/junit.xml] [--out DIR]    the conformance matrices as report.html, report.csv and report.junit.xml, each row with the result of its tests
  g5c-dossier dossier [--results build/junit.xml] [--out DIR]    everything a customer's procurement or security team asks for in one folder and one zip: the report, the test results,
                                                                 the regression summary, coverage, the SBOM, the licence audit, NOTICE, the threat model, the guides, the changelog, with a manifest of SHA-256 hashes

A row of the matrix names the ctest cases that prove it. Given the JUnit file of a run (ctest --output-junit), a row is `pass` when all of them passed, `fail` when one failed, `not run` when none
of them is in the file; rows without a test (status verified / partial / gap / out-of-scope) show their status as the matrix states it. A gap is a gap: it is listed, never hidden."""
import argparse
import csv
import datetime
import hashlib
import html
import io
import json
import shutil
import sys
import xml.etree.ElementTree as ET
import zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def load_rows():
    rows = []
    for f in sorted((ROOT / "docs" / "conformance").glob("*-matrix.json")):
        d = json.loads(f.read_text(encoding="utf-8"))
        for r in d["rows"]:
            r = dict(r)
            r["matrix"] = f.name
            rows.append(r)
    return rows


def load_results(path):
    """ctest name -> True (passed) / False (failed) / None (skipped) from a JUnit file."""
    res = {}
    if path and Path(path).exists():
        for tc in ET.parse(path).getroot().iter("testcase"):
            failed = tc.find("failure") is not None or tc.find("error") is not None
            res[tc.get("name")] = None if tc.find("skipped") is not None else (not failed)
    return res


def verdict(row, results):
    names = sorted({t["ctest"] for t in row.get("tests", []) if "ctest" in t})
    if not names:
        return row["status"], ""
    got = [results.get(n, "missing") for n in names]
    if results == {}:
        return "not run", ", ".join(names)
    if any(g is False for g in got):
        return "fail", ", ".join(n for n, g in zip(names, got) if g is False)
    if all(g is True for g in got):
        return "pass", ", ".join(names)
    return "not run", ", ".join(n for n, g in zip(names, got) if g in (None, "missing"))


def summary(rows, results):
    by_status, by_verdict = {}, {}
    for r in rows:
        by_status[r["status"]] = by_status.get(r["status"], 0) + 1
        v, _ = verdict(r, results)
        by_verdict[v] = by_verdict.get(v, 0) + 1
    return by_status, by_verdict


def write_csv(rows, results):
    out = io.StringIO()
    w = csv.writer(out)
    w.writerow(["id", "phase", "function", "spec", "clause", "status", "result", "tests", "procedure", "evidence"])
    for r in rows:
        v, t = verdict(r, results)
        w.writerow([r["id"], r["phase"], r["nf"], r["spec"], r["clause"], r["status"], v, t, r["procedure"], r.get("evidence", "")])
    return out.getvalue()


def write_junit(rows, results):
    suite = ET.Element("testsuite", name="g5c conformance matrix", tests=str(len(rows)))
    fails = skips = 0
    for r in rows:
        v, t = verdict(r, results)
        tc = ET.SubElement(suite, "testcase", classname="%s %s" % (r["spec"], r["clause"]), name="%s %s" % (r["id"], r["procedure"][:120]))
        if v == "fail":
            fails += 1
            ET.SubElement(tc, "failure", message="failed: %s" % t)
        elif v in ("gap", "out-of-scope", "partial", "not run"):
            skips += 1
            ET.SubElement(tc, "skipped", message=v)
    suite.set("failures", str(fails))
    suite.set("skipped", str(skips))
    return ET.tostring(suite, encoding="unicode", xml_declaration=False)


def write_html(rows, results, version):
    by_status, by_verdict = summary(rows, results)
    colour = {"pass": "#1b7f3b", "tested": "#1b7f3b", "verified": "#1b7f3b", "fail": "#b3261e", "gap": "#b3261e", "partial": "#9a6700", "not run": "#9a6700", "out-of-scope": "#57606a"}
    head = "".join("<li><b>%d</b> %s</li>" % (n, html.escape(k)) for k, n in sorted(by_verdict.items(), key=lambda kv: -kv[1]))
    trs = []
    for r in rows:
        v, t = verdict(r, results)
        trs.append("<tr><td>%s</td><td>%s</td><td>%s %s</td><td>%s</td><td style='color:%s'>%s</td><td>%s</td><td>%s</td></tr>" % (
            html.escape(r["id"]), html.escape(r["nf"]), html.escape(r["spec"]), html.escape(str(r["clause"])), html.escape(r["procedure"]), colour.get(v, "#000"), html.escape(v), html.escape(r["status"]),
            html.escape(t or r.get("evidence", ""))[:300]))
    return ("<!doctype html><html lang='en'><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>g5c conformance report</title>"
            "<style>body{font:14px system-ui;margin:16px}table{border-collapse:collapse;width:100%%}td,th{border:1px solid #8884;padding:4px 6px;vertical-align:top;font-size:12px}th{background:#1f3a5f;color:#fff;position:sticky;top:0}"
            "@media(prefers-color-scheme:dark){body{background:#111;color:#ddd}}</style>"
            "<h1>Conformance report, release %s</h1><p>%d rows from %d matrices. Result of the tests that prove each row, taken from the test run supplied with this report; a gap is listed as a gap.</p><ul>%s</ul>"
            "<table><tr><th>ID</th><th>Function</th><th>Specification</th><th>Procedure</th><th>Result</th><th>Matrix status</th><th>Tests / evidence</th></tr>%s</table></html>"
            % (html.escape(version), len(rows), len({r['matrix'] for r in rows}), head, "".join(trs)))


def version():
    v = ROOT / "VERSION"
    return v.read_text().strip() if v.exists() else "unknown"


def do_report(results_path, out):
    rows, results = load_rows(), load_results(results_path)
    out.mkdir(parents=True, exist_ok=True)
    (out / "report.html").write_text(write_html(rows, results, version()), encoding="utf-8")
    (out / "report.csv").write_text(write_csv(rows, results), encoding="utf-8", newline="")
    (out / "report.junit.xml").write_text(write_junit(rows, results), encoding="utf-8")
    return rows, results


DOSSIER_FILES = [
    ("build/junit.xml", "tests/junit.xml"), ("build/regress-summary.txt", "tests/regress-summary.txt"), ("build/coverage.json", "tests/coverage.json"),
    ("docs/sbom/g5c.cdx.json", "supply-chain/g5c.cdx.json"), ("NOTICE", "supply-chain/NOTICE"), ("docs/legal/THIRD_PARTY.md", "supply-chain/THIRD_PARTY.md"),
    ("docs/legal/patent-frand-review.md", "legal/patent-frand-review.md"), ("LICENSE", "legal/LICENSE"),
    ("docs/security/threat-model.md", "security/threat-model.md"), ("docs/security/lawful-intercept-design.md", "security/lawful-intercept-design.md"),
    ("docs/ops/slo.md", "operations/slo.md"), ("docs/ops/runbooks.md", "operations/runbooks.md"), ("docs/admin-guide.md", "operations/admin-guide.md"), ("docs/install.md", "operations/install.md"),
    ("docs/upgrade.md", "operations/upgrade.md"), ("docs/api/README.md", "operations/api-reference.md"), ("CHANGELOG.md", "CHANGELOG.md"), ("VERSION", "VERSION"),
    ("docs/release-process.md", "release-process.md"), ("docs/pilot-plan.md", "pilot-plan.md"), ("docs/perf/history.jsonl", "tests/performance-history.jsonl"),
]


def do_dossier(results_path, out):
    ver = version()
    if out.exists():
        shutil.rmtree(out)
    rows, results = do_report(results_path, out / "conformance")
    present, absent = [], []
    for src, dst in DOSSIER_FILES:
        p = ROOT / src
        if p.exists():
            (out / dst).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(p, out / dst)
            present.append(dst)
        else:
            absent.append(src)
    for f in sorted((ROOT / "docs" / "legal").glob("audit-*.md")):  # the licence audit of this release
        if ver in f.name:
            (out / "supply-chain").mkdir(exist_ok=True)
            shutil.copy2(f, out / "supply-chain" / f.name)
            present.append("supply-chain/" + f.name)
    by_status, by_verdict = summary(rows, results)
    reg = ROOT / "build" / "regress-summary.txt"
    last = [l for l in reg.read_text(errors="replace").splitlines() if l.strip()][-1] if reg.exists() else "no regression summary supplied"
    index = ("<!doctype html><html lang='en'><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>g5c dossier %s</title>"
             "<style>body{font:15px system-ui;margin:16px;max-width:860px}@media(prefers-color-scheme:dark){body{background:#111;color:#ddd}a{color:#8cf}}</style>"
             "<h1>g5c 5G core: release dossier %s</h1><p>Generated %s. Regression summary: <b>%s</b>.</p>"
             "<h2>Conformance</h2><p>%d matrix rows: %s.</p><ul><li><a href='conformance/report.html'>report.html</a></li><li><a href='conformance/report.csv'>report.csv</a></li><li><a href='conformance/report.junit.xml'>report.junit.xml</a></li></ul>"
             "<h2>Contents</h2><ul>%s</ul><p>Not included (open): %s. Counsel's sign-off of the licence audit is not part of this folder until it exists. Hashes: MANIFEST.sha256.</p></html>"
             % (html.escape(ver), html.escape(ver), datetime.date.today().isoformat(), html.escape(last), len(rows), ", ".join("%d %s" % (n, k) for k, n in sorted(by_verdict.items(), key=lambda kv: -kv[1])),
                "".join("<li><a href='%s'>%s</a></li>" % (html.escape(p), html.escape(p)) for p in sorted(present)), html.escape(", ".join(absent) or "nothing")))
    (out / "index.html").write_text(index, encoding="utf-8")
    files = sorted(p for p in out.rglob("*") if p.is_file())
    (out / "MANIFEST.sha256").write_text("".join("%s  %s\n" % (hashlib.sha256(p.read_bytes()).hexdigest(), p.relative_to(out).as_posix()) for p in files), encoding="utf-8")
    zpath = out.parent / ("g5c-dossier-%s.zip" % ver)
    with zipfile.ZipFile(zpath, "w", zipfile.ZIP_DEFLATED) as z:
        for p in sorted(out.rglob("*")):
            if p.is_file():
                z.write(p, "g5c-dossier-%s/%s" % (ver, p.relative_to(out).as_posix()))
    print("dossier: %d files, %d matrix rows (%s); missing: %s; %s" % (len(files), len(rows), by_verdict, ", ".join(absent) or "none", zpath))
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("cmd", choices=["report", "dossier"])
    ap.add_argument("--results", default=str(ROOT / "build" / "junit.xml"))
    ap.add_argument("--out")
    a = ap.parse_args()
    if a.cmd == "report":
        rows, results = do_report(a.results, Path(a.out or ROOT / "build" / "conformance-report"))
        by_status, by_verdict = summary(rows, results)
        print("report: %d rows %s" % (len(rows), by_verdict))
        return 0
    return do_dossier(a.results, Path(a.out or ROOT / "release" / "dossier"))


if __name__ == "__main__":
    sys.exit(main())
