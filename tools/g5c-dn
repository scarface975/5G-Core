#!/usr/bin/env python3
"""g5c-dn: the things behind N6 for scenarios (backlog B-14): a DNS server, an HTTP server, a UDP echo and a RADIUS AAA server, standard library only.

  g5c-dn --bind 10.45.0.1 [--dns 53] [--http 80] [--echo 7] [--radius 1812] [--zone zone.json] [--users users.json] [--secret S]

  DNS     answers A queries from the zone ({"name": "ip"}; "*" is the default answer); a name that is not in a zone without "*" gets NXDOMAIN
  HTTP    GET /          a small page;  GET /bytes/N  N bytes (throughput tests, N up to 100 MB);  GET /delay/MS  answers after MS milliseconds;  GET /status/CODE
  echo    returns every UDP datagram unchanged (loss, latency and jitter probes)
  RADIUS  Access-Request with a User-Password (PAP, RFC 2865): Access-Accept when {"user": "password"} in --users matches, else Access-Reject; the answer is authenticated with the shared secret
          (the AAA-S side of slice authentication, backlog A-09)
A port of 0 turns that service off; run it in the data network's namespace or on the host address behind the UPF's N6. Press Ctrl-C to stop."""
import argparse
import hashlib
import http.server
import json
import socket
import socketserver
import struct
import sys
import threading
import time


# ---- DNS ----------------------------------------------------------------------------------------------------------------------------------------------------------------
def dns_answer(query, zone):
    if len(query) < 12:
        return None
    tid = query[:2]
    qd = struct.unpack("!H", query[4:6])[0]
    if qd != 1:
        return tid + b"\x81\x04" + b"\x00" * 8  # NOTIMP
    i, labels = 12, []
    while i < len(query) and query[i] != 0:
        n = query[i]
        labels.append(query[i + 1:i + 1 + n].decode("ascii", "replace").lower())
        i += n + 1
    qend = i + 1 + 4
    name = ".".join(labels)
    qtype = struct.unpack("!H", query[i + 1:i + 3])[0] if i + 3 <= len(query) else 0
    question = query[12:qend]
    ip = zone.get(name, zone.get("*"))
    if ip is None:
        return tid + b"\x81\x83" + struct.pack("!HHHH", 1, 0, 0, 0) + question  # NXDOMAIN
    if qtype != 1:  # not an A query: an empty, successful answer
        return tid + b"\x81\x80" + struct.pack("!HHHH", 1, 0, 0, 0) + question
    rr = b"\xc0\x0c" + struct.pack("!HHIH", 1, 1, 60, 4) + socket.inet_aton(ip)
    return tid + b"\x81\x80" + struct.pack("!HHHH", 1, 1, 0, 0) + question + rr


# ---- RADIUS -------------------------------------------------------------------------------------------------------------------------------------------------------------
def radius_attrs(data):
    out, i = {}, 0
    while i + 2 <= len(data):
        t, ln = data[i], data[i + 1]
        if ln < 2 or i + ln > len(data):
            break
        out.setdefault(t, []).append(data[i + 2:i + ln])
        i += ln
    return out


def radius_pap(enc, secret, req_auth):
    out, prev = b"", req_auth
    for k in range(0, len(enc), 16):
        pad = hashlib.md5(secret + prev).digest()
        block = enc[k:k + 16]
        out += bytes(a ^ b for a, b in zip(block, pad))
        prev = block
    return out.rstrip(b"\x00")


def radius_answer(pkt, secret, users):
    if len(pkt) < 20 or pkt[0] != 1:  # Access-Request only
        return None
    code_id, length = pkt[1], struct.unpack("!H", pkt[2:4])[0]
    if length > len(pkt) or length < 20:
        return None
    req_auth, attrs = pkt[4:20], radius_attrs(pkt[20:length])
    user = attrs.get(1, [b""])[0].decode("utf-8", "replace")
    enc = attrs.get(2, [None])[0]
    ok = enc is not None and len(enc) % 16 == 0 and user in users and radius_pap(enc, secret, req_auth) == users[user].encode()
    code = 2 if ok else 3
    reply = b"welcome" if ok else b"rejected"
    body = bytes([18, 2 + len(reply)]) + reply  # Reply-Message
    head = struct.pack("!BBH", code, code_id, 20 + len(body))
    auth = hashlib.md5(head + req_auth + body + secret).digest()
    return head + auth + body


# ---- servers ------------------------------------------------------------------------------------------------------------------------------------------------------------
class UdpService(threading.Thread):
    def __init__(self, bind, port, handler):
        super().__init__(daemon=True)
        self.sock = socket.socket(socket.AF_INET6 if ":" in bind else socket.AF_INET, socket.SOCK_DGRAM)
        self.sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        self.sock.bind((bind, port))
        self.port, self.handler, self.stopping = self.sock.getsockname()[1], handler, False

    def run(self):
        while not self.stopping:
            try:
                data, peer = self.sock.recvfrom(4096)
            except OSError:
                return
            try:
                out = self.handler(data)
            except Exception:  # a malformed datagram must not stop the service
                out = None
            if out:
                self.sock.sendto(out, peer)

    def stop(self):
        self.stopping = True
        self.sock.close()


class HttpHandler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def _send(self, code, body, ctype="text/plain"):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def do_GET(self):
        p = self.path.split("?")[0]
        try:
            if p == "/":
                self._send(200, b"g5c data network\n")
            elif p.startswith("/bytes/"):
                n = int(p[7:])
                if not 0 <= n <= 100_000_000:
                    return self._send(400, b"0 to 100000000\n")
                self.send_response(200)
                self.send_header("Content-Type", "application/octet-stream")
                self.send_header("Content-Length", str(n))
                self.end_headers()
                chunk = b"\x5a" * 65536
                while n > 0:
                    self.wfile.write(chunk[:min(n, len(chunk))])
                    n -= min(n, len(chunk))
            elif p.startswith("/delay/"):
                time.sleep(min(int(p[7:]), 30000) / 1000.0)
                self._send(200, b"late\n")
            elif p.startswith("/status/"):
                self._send(int(p[8:]), b"status\n")
            else:
                self._send(404, b"not found\n")
        except (ValueError, BrokenPipeError, ConnectionResetError):
            try:
                self._send(400, b"bad request\n")
            except OSError:
                pass

    do_HEAD = do_GET


class Dn:
    """The running services; ports are those actually bound (port 0 asks the system for a free one, which the tests use)."""

    def __init__(self, bind, dns=None, http_port=None, echo=None, radius=None, zone=None, users=None, secret=b"g5c-secret"):
        self.udp, self.http, self.ports = [], None, {}
        zone = zone or {"*": "192.0.2.1"}
        for name, port, h in (("dns", dns, lambda d: dns_answer(d, zone)), ("echo", echo, lambda d: d), ("radius", radius, lambda d: radius_answer(d, secret, users or {}))):
            if port is not None:
                s = UdpService(bind, port, h)
                self.udp.append(s)
                self.ports[name] = s.port
        if http_port is not None:
            socketserver.ThreadingTCPServer.allow_reuse_address = True
            socketserver.ThreadingTCPServer.daemon_threads = True
            self.http = socketserver.ThreadingTCPServer((bind, http_port), HttpHandler)
            self.ports["http"] = self.http.server_address[1]

    def start(self):
        for s in self.udp:
            s.start()
        if self.http:
            threading.Thread(target=self.http.serve_forever, daemon=True).start()
        return self

    def stop(self):
        for s in self.udp:
            s.stop()
        if self.http:
            self.http.shutdown()
            self.http.server_close()


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--bind", default="0.0.0.0")
    for n, d in (("dns", 53), ("http", 80), ("echo", 7), ("radius", 1812)):
        ap.add_argument("--" + n, type=int, default=d, help="port (0: off), default %d" % d)
    ap.add_argument("--zone", help="JSON file {name: ip}")
    ap.add_argument("--users", help="JSON file {user: password}")
    ap.add_argument("--secret", default="g5c-secret", help="RADIUS shared secret")
    a = ap.parse_args()
    zone = json.load(open(a.zone)) if a.zone else None
    users = json.load(open(a.users)) if a.users else {}
    dn = Dn(a.bind, a.dns or None, a.http or None, a.echo or None, a.radius or None, zone, users, a.secret.encode()).start()
    print("g5c-dn on %s: %s" % (a.bind, ", ".join("%s %d" % kv for kv in sorted(dn.ports.items()))), flush=True)
    try:
        while True:
            time.sleep(3600)
    except KeyboardInterrupt:
        dn.stop()
    return 0


if __name__ == "__main__":
    sys.exit(main())
