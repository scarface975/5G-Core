#!/usr/bin/env python3
"""g5c-sdk: client libraries and a Postman collection generated from the OpenAPI documents the functions serve at GET /openapi.json (backlog G-01).

  g5c-sdk fetch   --out DIR  NAME=URL ...          save the documents of running functions (curl, HTTP/2 prior knowledge; TLS options in G5C_CURL_ARGS)
  g5c-sdk python  --from DIR --out g5c_sdk.py      a single-file Python client (standard library only), one class per function, one method per route
  g5c-sdk postman --from DIR --out g5c.postman.json  a Postman v2.1 collection, one folder per function, {{udm}}-style base URL variables

The Python client reaches the functions with curl (their SBI is HTTP/2 without an upgrade from HTTP/1.1, which the standard library cannot speak): `Client({"udm": "http://127.2.0.1:7773"}, token=...)`.
A different transport is any function (method, url, headers, body_bytes) -> (status, body_bytes): pass it as transport= (an httpx client with http2=True fits)."""
import argparse
import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def load_docs(d):
    docs = {}
    for f in sorted(Path(d).glob("*.json")):
        doc = json.loads(f.read_text(encoding="utf-8"))
        if "paths" in doc:
            docs[f.stem] = doc
    if not docs:
        raise SystemExit("g5c-sdk: no OpenAPI documents in %s" % d)
    return docs


def routes(doc):
    """(method, path, [path params]) sorted for stable output."""
    out = []
    for path, item in sorted(doc["paths"].items()):
        for method in sorted(item):
            if method in ("get", "post", "put", "patch", "delete", "head", "options"):
                out.append((method, path, re.findall(r"\{([^}]+)\}", path)))
    return out


def py_name(method, path, taken):
    segs = [re.sub(r"[^a-z0-9]+", "_", s.lower()).strip("_") for s in path.split("/") if s and not s.startswith("{")]
    base = "_".join([method] + [s for s in segs if s]) or method
    n, k = base, 2
    while n in taken:
        n, k = "%s_%d" % (base, k), k + 1
    taken.add(n)
    return n


CLIENT_HEAD = '''"""Client for the g5c 5G core's service based interfaces, generated by tools/g5c-sdk from the OpenAPI documents of the functions (release @@VERSION@@).

    from g5c_sdk import Client
    c = Client({"udm": "http://127.2.0.1:7773"}, token="admin-token")      # base URL per function; G5C_CURL_ARGS carries the TLS options of curl
    status, body = c.udm.get_admin_v1_subscribers()
Every method returns (HTTP status, parsed JSON or text). Path parameters are positional arguments in path order; body= is sent as JSON, query= as a dict."""
import json
import os
import shlex
import subprocess
import urllib.parse


def _curl(method, url, headers, body):
    cmd = ["curl", "-s", "--max-time", "30", "--http2-prior-knowledge", "-X", method, "-w", "\\n%{http_code}"] + shlex.split(os.environ.get("G5C_CURL_ARGS", ""))
    for k, v in headers.items():
        cmd += ["-H", "%s: %s" % (k, v)]
    if body is not None:
        cmd += ["--data-binary", "@-"]
    p = subprocess.run(cmd + [url], input=body, capture_output=True)
    if p.returncode != 0:
        raise OSError("curl failed (%d): %s" % (p.returncode, p.stderr.decode(errors="replace")[:200]))
    data, _, code = p.stdout.rpartition(b"\\n")
    return int(code), data


class _Function:
    def __init__(self, client, name):
        self._c, self._name = client, name

    def _call(self, method, template, params, args, body=None, query=None):
        if len(args) != len(params):
            raise TypeError("%s %s takes %d path parameter(s): %s" % (method, template, len(params), ", ".join(params)))
        path = template
        for p, v in zip(params, args):
            path = path.replace("{" + p + "}", urllib.parse.quote(str(v), safe=""))
        return self._c._request(self._name, method, path, body, query)


class Client:
    def __init__(self, urls, token=None, transport=None):
        self.urls, self.token, self.transport = dict(urls), token, transport or _curl
        for name in @@NAMES@@:
            if name in self.urls:
                setattr(self, name, _FUNCTIONS[name](self, name))

    def _request(self, fn, method, path, body, query):
        url = self.urls[fn].rstrip("/") + path + ("?" + urllib.parse.urlencode(query, doseq=True) if query else "")
        headers = {"accept": "application/json"}
        data = None
        if body is not None:
            headers["content-type"] = "application/json"
            data = json.dumps(body).encode()
        if self.token:
            headers["authorization"] = "Bearer " + self.token
        status, raw = self.transport(method.upper(), url, headers, data)
        text = raw.decode(errors="replace") if isinstance(raw, bytes) else raw
        try:
            return status, json.loads(text) if text.strip() else None
        except ValueError:
            return status, text

'''


def gen_python(docs, out):
    version = next(iter(docs.values()))["info"].get("version", "?")
    names = sorted(re.sub(r"[^a-z0-9_]", "_", n.lower()) for n in docs)
    parts = [CLIENT_HEAD.replace("@@VERSION@@", version).replace("@@NAMES@@", repr(names))]
    classes = []
    for fn in sorted(docs):
        cname = re.sub(r"[^a-z0-9_]", "_", fn.lower())
        taken = set()
        body = ["class _%s(_Function):" % cname.upper(), '    """%s"""' % docs[fn]["info"].get("title", fn).replace('"', "'")]
        for method, path, params in routes(docs[fn]):
            name = py_name(method, path, taken)
            sig = "self, *args, body=None, query=None" if method in ("post", "put", "patch", "delete") else "self, *args, query=None"
            call = "self._call(%r, %r, %r, args, %s)" % (method, path, params, "body, query" if "body" in sig else "None, query")
            body += ["", "    def %s(%s):" % (name, sig), '        """%s %s%s"""' % (method.upper(), path, "" if not params else "  (path: %s)" % ", ".join(params)), "        return " + call]
        parts.append("\n".join(body) + "\n\n")
        classes.append((cname, "_%s" % cname.upper()))
    parts.append("_FUNCTIONS = {%s}\n" % ", ".join("%r: %s" % c for c in classes))
    Path(out).write_text("".join(parts), encoding="utf-8")


def gen_postman(docs, out):
    items = []
    for fn in sorted(docs):
        reqs = []
        for method, path, params in routes(docs[fn]):
            segs = [("{{%s}}" % s[1:-1] if s.startswith("{") else s) for s in path.split("/") if s]
            reqs.append({"name": "%s %s" % (method.upper(), path), "request": {"method": method.upper(), "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
                                                                              "url": {"raw": "{{%s}}%s" % (fn, path.replace("{", "{{").replace("}", "}}")), "host": ["{{%s}}" % fn], "path": segs}}})
        items.append({"name": fn, "item": reqs})
    coll = {"info": {"name": "g5c 5G core", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
                     "description": "Generated by tools/g5c-sdk from the functions' /openapi.json. Set the base URL variables (one per function) and {{token}}."},
            "item": items, "variable": [{"key": fn, "value": "http://127.0.0.1:0"} for fn in sorted(docs)] + [{"key": "token", "value": ""}]}
    Path(out).write_text(json.dumps(coll, indent=1), encoding="utf-8")


def do_fetch(out, pairs):
    Path(out).mkdir(parents=True, exist_ok=True)
    for pair in pairs:
        name, _, url = pair.partition("=")
        p = subprocess.run(["curl", "-s", "--max-time", "10", "--http2-prior-knowledge"] + shlex.split(os.environ.get("G5C_CURL_ARGS", "")) + [url.rstrip("/") + "/openapi.json"], capture_output=True, text=True)
        if p.returncode != 0:
            raise SystemExit("g5c-sdk: cannot read %s (curl exit %d)" % (url, p.returncode))
        json.loads(p.stdout)  # must be JSON
        (Path(out) / (name + ".json")).write_text(p.stdout, encoding="utf-8")
    print("fetched", len(pairs), "documents into", out)


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    f = sub.add_parser("fetch")
    f.add_argument("--out", required=True)
    f.add_argument("pairs", nargs="+", metavar="NAME=URL")
    for c in ("python", "postman"):
        s = sub.add_parser(c)
        s.add_argument("--from", dest="src", required=True)
        s.add_argument("--out", required=True)
    a = ap.parse_args()
    if a.cmd == "fetch":
        do_fetch(a.out, a.pairs)
    elif a.cmd == "python":
        gen_python(load_docs(a.src), a.out)
        print("wrote", a.out)
    else:
        gen_postman(load_docs(a.src), a.out)
        print("wrote", a.out)
    return 0


if __name__ == "__main__":
    sys.exit(main())
