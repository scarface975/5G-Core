#!/usr/bin/env bash
# Capture the signalling and the user plane of a g5c core with tshark / dumpcap, with the filters of its interfaces.
#
#   g5c-capture <what> [-i IFACE] [-w FILE] [-r SECONDS] [--print]
#
#   what: n2     NGAP over SCTP (gNB - AMF), port 38412
#         n4     PFCP (SMF - UPF), UDP 8805
#         n3     GTP-U (gNB - UPF), UDP 2152 (the user plane: every UE packet)
#         sbi    the service based interfaces (TCP 7773-7790 and 9091). With mutual TLS (the default of this release) only TLS records are visible: the content is encrypted
#         core   n2 + n4 + n3 + sbi          signalling   n2 + n4 + the sbi ports
#   -i IFACE   interface (default: any)      -w FILE   output (default g5c-<what>-<date>.pcapng)
#   -r SECONDS stop after this time          --print   only print the command
#
# The capture holds subscriber identities (SUCI / GUTI / IMSI in NAS, the UE addresses): treat the file as personal data. tools/cli/g5c-redact does not work on a pcap.
# Needs root or the capture capability (sudo, or: sudo setcap cap_net_raw,cap_net_admin+eip $(command -v dumpcap)).
set -euo pipefail
what="${1:-}"; shift || true
IFACE=any; OUT=""; SECS=""; PRINT=0
while [ $# -gt 0 ]; do
  case "$1" in -i) IFACE="$2"; shift 2;; -w) OUT="$2"; shift 2;; -r) SECS="$2"; shift 2;; --print) PRINT=1; shift;; *) echo "unknown argument $1"; exit 2;; esac
done
SBI="tcp portrange 7773-7790 or tcp port 9091 or tcp port 7777"
case "$what" in
  n2) F="sctp port 38412";;
  n4) F="udp port 8805";;
  n3) F="udp port 2152";;
  sbi) F="$SBI";;
  core) F="sctp port 38412 or udp port 8805 or udp port 2152 or $SBI";;
  signalling|signaling) F="sctp port 38412 or udp port 8805 or $SBI";;
  ""|-h|--help) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
  *) echo "unknown capture '$what' (n2 n4 n3 sbi core signalling)"; exit 2;;
esac
OUT="${OUT:-g5c-$what-$(date -u +%Y%m%dT%H%M%SZ).pcapng}"
TOOL="$(command -v dumpcap || command -v tshark || true)"
[ -n "$TOOL" ] || [ "$PRINT" = 1 ] || { echo "neither dumpcap nor tshark is installed (sudo apt install tshark)"; exit 1; }
CMD=("${TOOL:-dumpcap}" -q -i "$IFACE" -f "$F" -w "$OUT")
[ -n "$SECS" ] && CMD+=(-a "duration:$SECS")
if [ "$PRINT" = 1 ]; then printf '%q ' "${CMD[@]}"; echo; exit 0; fi
echo "capturing '$F' on $IFACE into $OUT (Ctrl+C stops)"
exec "${CMD[@]}"
